@startuml
title 'Warm house' Component Diagram

top to bottom direction

' !includeurl https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Component.puml
!include ../lib/C4_Component.puml

'#### Домены (Warm House):
'- Управление устройствами (_передача команд и информационный обмен_)
'   - Передача управляющих команд на абонентские устройства
'   - Мониторинг состояния и показаний абонентских устройств
'
'- Взаимодействие пользователей с системой
'    - Визуализация данных (презентация телеметрии)
'    - Ручное управление устройствами (кнопки)
'    - Конфигурирования и настройка
'    - Регистрация пользователей
'    - Управление доступом пользователей (аутентификация и авторизация)
'
'- Управление конфигурациями (личный кабинет, группа устройств пользователя)
'    - Планировщик (настройка сценариев, управление устройствами по расписанию, Scheduler)
'    - Регистрация новых абонентских устройств (типовых и custom)
'      - Отопление
'      - Освещение
'      - Автоматические ворота
'      - Видеонаблюдение
'      - Универсальный датчик


' Container(DeviceControlContainer, "Управление устройствами", "Используемые технологии", "Обеспечение управление всеми абонентскими устройствами пользователей на основе из настроек в профилях пользователей")
' Container(Queue, "Шина данных", "Используемые технологии", "Обеспечение взаимодействия между сервисами")

Container_Boundary(WarmHouse, "Warm house") {
  Container(DeviceControlContainer, "Управление устройствами", "Используемые технологии", "Обеспечение управление всеми абонентскими устройствами \n пользователей на основе из настроек в профилях пользователей")
  Container(Queue, "Шина данных", "Используемые технологии", "Обеспечение взаимодействия между сервисами")
  Container(Database, "Database", "PostgreSQL", "Stores user data and schedules")
}

  Container(DeviceControlContainer, "Управление устройствами", "") {
  Component(CommandController, "Передача управляющих команд на абонентские устройства", "command exchange")
  Component(TelemetryController, "Мониторинг состояния и показаний абонентских устройств", "Manages user profiles")

'  Component(ServiceLayer, "Service Layer", "Business logic")
'  Component(RepositoryLayer, "Repository Layer", "Data access logic")
}
System_Ext(homeDevices, "Абонентские устройства", "Собирательный образ абонентских устройств пользователей системы")


'Rel(AuthController,ServiceLayer,"Calls business logic")
'Rel(UserController,ServiceLayer,"Calls business logic")
'Rel(ScheduleController,ServiceLayer,"Calls business logic")
'Rel(PaymentController,ServiceLayer,"Calls business logic")
'Rel(ServiceLayer,RepositoryLayer,"Reads/Writes data")

Rel(Database,CommandController,"Профили устройств")
Rel(TelemetryController,Database,"Данные о запросах и телеметрия")
Rel(Database,TelemetryController,"Профили устройств")
Rel(CommandController,Queue,"Результат выполнения команд")
Rel(Queue,TelemetryController,"Запрос информации с устройств")

'Rel(CommandController,homeDevices,"Reads/Writes device data")
'Rel(TelemetryController,homeDevices,"Reads/Writes device data")

CommandController <--> homeDevices : Команды управления \n результат выполнения
TelemetryController<--> homeDevices: Обмен данными телеметрии


@enduml